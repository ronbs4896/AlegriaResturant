# ── מסד נתונים ───────────────────────────────────────────────
# בייצור: מחרוזת החיבור מ-Neon.
# בפיתוח: השאירו ריק, והמערכת תשתמש ב-PGlite מקומי (Postgres ב-WASM).
DATABASE_URL=

# ── אחסון קבצים ──────────────────────────────────────────────
# Vercel Blob, חנות פרטית. נוצר אוטומטית בהקמת הפרויקט ב-Vercel.
BLOB_READ_WRITE_TOKEN=

# ── שליחת מיילים (קוד התחברות) ───────────────────────────────
RESEND_API_KEY=
AUTH_FROM_EMAIL=books@alegriacatering.co.il

# ── מי מורשה להיכנס ──────────────────────────────────────────
# רשימה מופרדת בפסיקים. תפקיד ברירת מחדל: uploader.
# להוספת מנהל: email:admin
AUTH_ALLOWLIST=ronbenshushan000@gmail.com:admin

# ── סוד לחתימת עוגיית ההתחברות ───────────────────────────────
# צרו עם: openssl rand -base64 48
SESSION_SECRET=

# ── פרטי העסק ────────────────────────────────────────────────
# ח.פ. של אלגריה — זה מה שמכריע אם מסמך הוא הוצאה או הכנסה.
BUSINESS_TAX_ID=
BUSINESS_NAME=קייטרינג אלגריה

# ── חילוץ שדות ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── קליטה מהמייל (שלב 4) ─────────────────────────────────────
INBOUND_WEBHOOK_SECRET=
