# ── מסד נתונים ───────────────────────────────────────────────
# בייצור: מחרוזת החיבור מ-Neon.
# בפיתוח: השאירו ריק, והמערכת תשתמש ב-PGlite מקומי (Postgres ב-WASM).
DATABASE_URL=

# ── אחסון קבצים ──────────────────────────────────────────────
# Vercel Blob, חנות פרטית. נוצר אוטומטית בהקמת הפרויקט ב-Vercel.
BLOB_READ_WRITE_TOKEN=

# ── שליחת מיילים (קוד התחברות) ───────────────────────────────
RESEND_API_KEY=
AUTH_FROM_EMAIL=books@alegriacatering.co.il

# ── מי מורשה להיכנס ──────────────────────────────────────────
# רשימה מופרדת בפסיקים. תפקיד ברירת מחדל: uploader.
# להוספת מנהל: email:admin
AUTH_ALLOWLIST=ronbenshushan000@gmail.com:admin

# ── סוד לחתימת עוגיית ההתחברות ───────────────────────────────
# צרו עם: openssl rand -base64 48
SESSION_SECRET=

# ── פרטי העסק ────────────────────────────────────────────────
# ח.פ. של אלגריה — זה מה שמכריע אם מסמך הוא הוצאה או הכנסה.
BUSINESS_TAX_ID=
BUSINESS_NAME=קייטרינג אלגריה

# ── חילוץ שדות ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── קליטה מהמייל ─────────────────────────────────────────────
# הסוד שמופיע ב-Resend תחת ה-webhook, מתחיל ב-whsec_.
# בלעדיו נקודת הקליטה מסרבת לקלוט. זו התנהגות מכוונת: עדיף
# שהקליטה לא תעבוד מאשר שתהיה פתוחה לכל אחד.
INBOUND_WEBHOOK_SECRET=

# ── תיבות מייל שמהן מושכים מסמכים ───────────────────────────
# חיבור ישיר ב-IMAP. ב-Gmail צריך אימות דו-שלבי פעיל ואז
# סיסמת אפליקציה מ-myaccount.google.com/apppasswords —
# לא סיסמת החשבון הרגילה.
#
# ב-Gmail וב-Outlook מספיקים שני השדות; השרת נגזר מהדומיין.
MAILBOX_1_USER=
MAILBOX_1_PASSWORD=
# MAILBOX_1_HOST=mail.example.co.il    # רק לספק שאינו מוכר
# MAILBOX_1_FOLDER=INBOX               # ברירת המחדל: התיקייה שהשרת מסמן כ\All
# MAILBOX_1_SINCE=2026-01-01           # ברירת המחדל: שנה אחורה. לא סורקים עמוק יותר
# MAILBOX_1_IMAGES=true                # ברירת המחדל: PDF בלבד. תמונה בתיבה אישית
#                                      # היא כמעט תמיד פרטית, וקבלות נייר עולות מהטלפון
#
# תיבה נוספת: MAILBOX_2_USER / MAILBOX_2_PASSWORD וכן הלאה.
